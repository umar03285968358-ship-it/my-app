{
  "expo": {
    "name": "Jinnah Mart",
    "slug": "logixSolutionz",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "com.umarabdullah123.logixsolutionz",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.umarabdullah123.logixsolutionz"
    },

    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.umarabdullah123.logixsolutionz",
      "softwareKeyboardLayoutMode": "resize",
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },

    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },

    "plugins": [
      [
        "onesignal-expo-plugin",
        {
          "mode": "production"
        }
      ],

      "expo-router",

      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],

      "expo-web-browser",

      "@react-native-community/datetimepicker",

      "@react-native-google-signin/google-signin",

      [
        "expo-build-properties",
        {
          "android": {
            "ndkVersion": "27.1.12297006",
            "usesCleartextTraffic": false
          }
        }
      ],

      "expo-secure-store",

      "./plugins/withTelQueries",
      "./plugins/withRemoveOneSignalBootReceiver"
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "d69c5e64-a632-47e5-a7b9-99d1f156684d"
      }
    }
  }
}
